# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://finora:finora@localhost:5434/finora?schema=public"

# ── Auth (Auth.js) ────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_TRUST_HOST=true
# AUTH_URL="https://finora.example.com"

# ── Encryption at rest for receipts (32-byte hex) ─────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""
# Private storage directory for encrypted receipts (never served publicly)
STORAGE_DIR="./storage"

# ── Background jobs ───────────────────────────────────────
# Shared secret for POST /api/cron (used by external schedulers)
CRON_SECRET=""

# ── AI provider (optional) ────────────────────────────────
# Supported: "anthropic" or "none". With "none", the assistant runs in an
# offline deterministic mode and AI categorization/OCR are disabled.
AI_PROVIDER="none"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"

# ── Exchange rates ────────────────────────────────────────
# Frankfurter (ECB reference rates, no key). Set to "none" to disable network lookups.
FX_PROVIDER="frankfurter"
FX_API_URL="https://api.frankfurter.app"

# ── Email notifications (optional, via Resend HTTP API) ───
RESEND_API_KEY=""
EMAIL_FROM="Finora <notifications@example.com>"

# ── Bank sync (optional) ──────────────────────────────────
# No provider is bundled. Leave empty — Finora will never claim a bank connection.
BANK_SYNC_PROVIDER=""

# ── Rate limiting ─────────────────────────────────────────
# Multiplies all rate limits (keep 1 in production; raised for automated tests)
RATE_LIMIT_SCALE=1
